# Names only — never commit values. Copy to .env.local and fill in.
# Validated at startup by src/lib/env.ts (docs/trd.md §6).

# --- Required from M1 ---
# local | test | staging | production
APP_ENV=
# Provider id, or "mock" (not allowed when APP_ENV=production)
AI_PROVIDER=
# Public base URL, e.g. the local dev server address
NEXT_PUBLIC_SITE_URL=

# --- Required from M2 (local values: npm run db:env) ---
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...); legacy anon key also works
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...), server only; legacy service_role key also works
SUPABASE_SECRET_KEY=
# Local email catcher (tests only)
MAIL_CATCHER_URL=

# --- M5 (optional; defaults in src/lib/env.ts) ---
# Total budget for one AI reply in ms (default 25000)
AI_REPLY_DEADLINE_MS=
# Learner messages per conversation (default 20)
CONVERSATION_MAX_TURNS=

# --- Provider eval only (npm run eval:providers; never NEXT_PUBLIC_) ---
# Read by scripts/eval-providers.mts, not by the app. Leave empty for --dry-run.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model overrides (defaults and prices: tests/evals/config.json)
EVAL_ANTHROPIC_MODEL=
EVAL_OPENAI_MODEL=

# --- Added in later milestones (not read yet) ---
# M6: AI provider and limits
AI_API_KEY=
AI_MODEL_CONVERSATION=
AI_MODEL_FEEDBACK=
AI_MODEL_HINT=
AI_MAX_OUTPUT_TOKENS_REPLY=
AI_MAX_OUTPUT_TOKENS_FEEDBACK=
AI_MAX_OUTPUT_TOKENS_HINT=
AI_TIMEOUT_MS=
AI_FEEDBACK_DEADLINE_MS=
LIMIT_REPLIES_PER_DAY=
LIMIT_HINTS_PER_DAY=
LIMIT_FEEDBACK_ATTEMPTS_PER_SESSION=
AI_GLOBAL_DAILY_LIMIT=
# Deferred (tool not chosen yet)
ERROR_MONITORING_DSN=
LOG_LEVEL=
